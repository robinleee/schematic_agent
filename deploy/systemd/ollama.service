[Unit]
Description=Ollama LLM server (gemma4:26b, schematic_agent)
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/data

[Service]
Type=simple
User=caros
Group=caros
Environment=HOME=/home/caros
Environment=OLLAMA_HOST=127.0.0.1:11434
Environment=OLLAMA_MODELS=/data/gemma4/models
WorkingDirectory=/data/schematic_agent
ExecStart=/data/gemma4/bin/ollama serve
Restart=always
RestartSec=5
TimeoutStopSec=30
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
