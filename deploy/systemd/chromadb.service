[Unit]
Description=schematic_agent ChromaDB (knowledge vectors :8000)
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/data

[Service]
Type=simple
User=caros
Group=caros
Environment=HOME=/home/caros
WorkingDirectory=/data/schematic_agent
ExecStart=/data/schematic_agent/.venv/bin/chroma run --host 127.0.0.1 --port 8000 --path /data/schematic_agent/chroma_data
Restart=always
RestartSec=5
TimeoutStopSec=30
StandardOutput=append:/data/schematic_agent/logs/chromadb.log
StandardError=append:/data/schematic_agent/logs/chromadb.log

[Install]
WantedBy=multi-user.target
