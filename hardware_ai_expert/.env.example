# Neo4j Database Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# Neo4j Read-Only Account (for Agent runtime)
NEO4J_READONLY_USER=neo4j_reader
NEO4J_READONLY_PASSWORD=changeme

# LLM API Configuration (Ollama)
LLM_API_BASE=http://localhost:11434/v1
LLM_MODEL_NAME=gemma4:26b

# Vector DB Configuration
CHROMA_PERSIST_DIR=./data/chroma_db

# Embedding Model Configuration
SCHEMATIC_EMBEDDING_MODEL=BAAI/bge-m3
SCHEMATIC_EMBEDDING_DIM=1024

# --- Tier3 Public Web Retrieval ---
TIER3_ENABLED=true
TIER3_TYPE=lightweight
TIER3_LLM_EXTRACT=true
TIER3_SCRAPE_TIMEOUT=15
TIER3_MAX_CONTENT_LEN=6000

# --- Local dev only: skip production API_TOKEN/CORS enforcement ---
# Set to "production" to enforce API_TOKEN/CORS; "offline" bypasses them for local dev.
API_SECURITY_MODE=offline
